// QA D1 and schema success confirmed by user; only the approved branch origin can use it.
{
  "name": "playformosa",
  "compatibility_date": "2026-10-25",
  "main": "worker/leaderboard/index.mjs",
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "playformosa-leaderboard-qa",
        "database_id": "75be2ba1-d2b8-455d-82c2-e5392ead01d4"
      }
    ],
    "vars": {
      "LEADERBOARD_SCOPE": "qa",
      "LEADERBOARD_ORIGIN": "https://preview-hurdles-playformosa.playformosa.workers.dev",
      "LEADERBOARD_ENABLED": "true",
      "PLAY_COUNTS_ENABLED": "true"
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/leaderboard*",
      "/api/play-counts*"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
